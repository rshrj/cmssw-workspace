#!/usr/bin/env bash

set -euo pipefail

INSTANCE="${CMSSW_LIMA_INSTANCE:-cmssw}"
SSH_ALIAS="lima-${INSTANCE}"

SCRIPT_DIR="$(
  cd "$(dirname "${BASH_SOURCE[0]}")"
  pwd
)"

REPO_ROOT="$(
  cd "$SCRIPT_DIR/.."
  pwd
)"

ARCH=""
RELEASE=""
PACKAGE=""
JOBS=""
WORKDIR=""
SMOKE_TEST=""


usage() {
  cat <<EOF
Usage:

  cmssw-bootstrap --release RELEASE --arch ARCH
  cmssw-bootstrap --smoke-test [el8]

Options:

  --release RELEASE   CMSSW release/IB to create, or an IB series such as
                      CMSSW_20_1_X to use its newest available IB
  --arch ARCH         SCRAM architecture; el8 architectures run in the
                      el8 container (cmssw-el8) on the el9 VM
  --package PACKAGE   Package to add before building
  --jobs N            Parallel build jobs
  --workdir DIR       Guest directory for the release area (default ~/work)
  --smoke-test [el8]  Use pinned values from config/smoke-test.env, or
                      config/smoke-test-el8.env, in a new directory
                      under ~/scratch unless --workdir is given
  -h, --help          Show this help

Examples:

  cmssw-bootstrap --smoke-test

  cmssw-bootstrap \\
    --arch el9_aarch64_gcc14 \\
    --release CMSSW_20_1_0_pre3

  cmssw-bootstrap \\
    --arch el9_aarch64_gcc14 \\
    --release CMSSW_20_1_X \\
    --package DataFormats/SiStripCluster \\
    --jobs 6

  cmssw-bootstrap \\
    --arch el8_aarch64_gcc13 \\
    --release CMSSW_20_0_0_patch1
EOF
}


while (($#)); do
  case "$1" in
    --release)
      RELEASE="${2:?missing value for --release}"
      shift 2
      ;;

    --arch)
      ARCH="${2:?missing value for --arch}"
      shift 2
      ;;

    --package)
      PACKAGE="${2:?missing value for --package}"
      shift 2
      ;;

    --jobs)
      JOBS="${2:?missing value for --jobs}"
      shift 2
      ;;

    --workdir)
      WORKDIR="${2:?missing value for --workdir}"
      shift 2
      ;;

    --smoke-test)
      SMOKE_TEST=default
      shift

      if [[ "${1:-}" == el8 ]]; then
        SMOKE_TEST=el8
        shift
      fi
      ;;

    -h|--help)
      usage
      exit 0
      ;;

    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done


if [[ -n "$SMOKE_TEST" ]]; then
  if [[ "$SMOKE_TEST" == el8 ]]; then
    SMOKE_CONFIG="$REPO_ROOT/config/smoke-test-el8.env"
  else
    SMOKE_CONFIG="$REPO_ROOT/config/smoke-test.env"
  fi

  if [[ ! -f "$SMOKE_CONFIG" ]]; then
    echo "ERROR: smoke-test config not found:" >&2
    echo "  $SMOKE_CONFIG" >&2
    exit 1
  fi

  # shellcheck disable=SC1090
  source "$SMOKE_CONFIG"

  ARCH="${ARCH:-$SCRAM_ARCH}"
  RELEASE="${RELEASE:-$CMSSW_RELEASE}"
  PACKAGE="${PACKAGE:-$CMSSW_SMOKE_PACKAGE}"
  JOBS="${JOBS:-$CMSSW_BUILD_JOBS}"

  # A fresh directory, so existing areas under ~/work are never touched.
  # The ~ is expanded by the guest shell.
  WORKDIR="${WORKDIR:-~/scratch/smoke-test-$(date +%Y%m%d-%H%M%S)}"
fi


if [[ -z "$ARCH" ]]; then
  echo "ERROR: --arch is required" >&2
  exit 2
fi

if [[ -z "$RELEASE" ]]; then
  echo "ERROR: --release is required" >&2
  exit 2
fi

JOBS="${JOBS:-6}"
WORKDIR="${WORKDIR:-~/work}"

# An unquoted ~ is expanded by the macOS shell, not the guest one.
if [[ "$WORKDIR" == "$HOME"* ]]; then
  echo "ERROR: --workdir is a macOS path: $WORKDIR" >&2
  echo "Quote it (--workdir '~/scratch/x') or give a guest path." >&2
  exit 2
fi


if ! [[ "$JOBS" =~ ^[1-9][0-9]*$ ]]; then
  echo "ERROR: --jobs must be a positive integer" >&2
  exit 2
fi


if ! ssh -G "$SSH_ALIAS" >/dev/null 2>&1; then
  echo "ERROR: SSH host '$SSH_ALIAS' is not configured." >&2
  echo "Run: cmsvm host-setup" >&2
  exit 1
fi


status="$(
  limactl list "$INSTANCE" --format '{{.Status}}' 2>/dev/null || true
)"

if [[ "$status" != "Running" ]]; then
  echo "==> Starting Lima instance: $INSTANCE"
  limactl start "$INSTANCE" >/dev/null
fi


# el8 releases run in the el8 container on the el9 VM: a native el8 VM
# cannot boot on Apple Silicon (its kernel uses 64 KB pages).
case "${ARCH%%_*}" in
  el8|cc8|cs8|alma8) ARCH_OS=8 ;;
  el9|cs9|alma9)     ARCH_OS=9 ;;
  *)                 ARCH_OS="" ;;
esac

GUEST_OS="$(ssh "$SSH_ALIAS" rpm -E %rhel)"

if [[ "$ARCH_OS" == "$GUEST_OS" ]]; then
  RUNNER=(bash)
elif [[ "$ARCH_OS" == 8 && "$GUEST_OS" == 9 ]]; then
  if ! ssh "$SSH_ALIAS" test -x '~/bin/cmssw-el8'; then
    echo "ERROR: ~/bin/cmssw-el8 is missing in the VM." >&2
    echo "Run: cmsvm sync" >&2
    exit 1
  fi
  RUNNER=('~/bin/cmssw-el8' bash)
else
  echo "ERROR: $ARCH needs ${ARCH%%_*}, but '$INSTANCE' runs EL$GUEST_OS." >&2
  echo "Supported here: el$GUEST_OS architectures natively, and el8 ones" >&2
  echo "in the el8 container." >&2
  exit 1
fi


echo "==> CMSSW bootstrap"
echo "    architecture: $ARCH"
echo "    release:      $RELEASE"
echo "    directory:    $WORKDIR"

if [[ "$ARCH_OS" != "$GUEST_OS" ]]; then
  echo "    container:    cmssw-el8"
fi

if [[ -n "$PACKAGE" ]]; then
  echo "    package:      $PACKAGE"
  echo "    build jobs:   $JOBS"
fi

echo

PACKAGE_ARG="${PACKAGE:-__NONE__}"

ssh "$SSH_ALIAS" "${RUNNER[@]}" -s -- \
  "$ARCH" \
  "$RELEASE" \
  "$PACKAGE_ARG" \
  "$JOBS" \
  "$WORKDIR" <<'REMOTE'
set -eo pipefail

ARCH="$1"
RELEASE="$2"
PACKAGE="$3"
JOBS="$4"
WORKDIR="$5"

if [[ "$PACKAGE" == "__NONE__" ]]; then
  PACKAGE=""
fi


CMSSET_DEFAULT="/cvmfs/cms.cern.ch/cmsset_default.sh"


echo "==> Checking CMS environment"

if [[ ! -r "$CMSSET_DEFAULT" ]]; then
  echo "ERROR: CMS environment not available:" >&2
  echo "  $CMSSET_DEFAULT" >&2
  exit 1
fi

export SCRAM_ARCH="$ARCH"

# shellcheck disable=SC1090
source "$CMSSET_DEFAULT"


echo "==> Checking SCRAM architecture"

if ! command -v scram >/dev/null 2>&1; then
  echo "ERROR: scram is unavailable for SCRAM_ARCH=$SCRAM_ARCH" >&2
  exit 1
fi


echo "==> Checking release availability"

AVAILABLE="$(scram list CMSSW)"

# IBs only stay on CVMFS for a few weeks, so a series name such as
# CMSSW_20_1_X picks its newest IB. Dated names sort chronologically.
if [[ "$RELEASE" =~ ^CMSSW_[0-9]+_[0-9]+_X$ ]]; then
  SERIES="$RELEASE"
  RELEASE="$(
    awk -v prefix="${SERIES}_" '
      $1 == "CMSSW" && index($2, prefix) == 1 {
        print $2
      }
    ' <<<"$AVAILABLE" |
      sort |
      tail -1
  )"

  if [[ -z "$RELEASE" ]]; then
    echo "ERROR: no $SERIES IB is available for $SCRAM_ARCH" >&2
    exit 1
  fi

  echo "    $SERIES -> $RELEASE"
fi

if ! awk -v release="$RELEASE" '
    $1 == "CMSSW" && $2 == release {
      found = 1
    }
    END {
      exit !found
    }
  ' <<<"$AVAILABLE"
then
  echo "ERROR: release is not available for $SCRAM_ARCH:" >&2
  echo "  $RELEASE" >&2
  exit 1
fi

RELEASE_DIR="$WORKDIR/$RELEASE"


echo "==> Checking Git identity"

for key in user.name user.email user.github; do
  if [[ -z "$(git config --global --get "$key" || true)" ]]; then
    echo "ERROR: guest Git configuration is missing $key" >&2
    exit 1
  fi
done


if [[ -e "$RELEASE_DIR" ]]; then
  echo "ERROR: release area already exists:" >&2
  echo "  $RELEASE_DIR" >&2
  echo >&2
  echo "Refusing to modify an existing development area." >&2
  exit 1
fi


mkdir -p "$WORKDIR"
cd "$WORKDIR"


echo "==> Creating CMSSW release area"

cmsrel "$RELEASE"

cd "$RELEASE/src"


echo "==> Activating CMSSW environment"

cmsenv

if [[ "$CMSSW_VERSION" != "$RELEASE" ]]; then
  echo "ERROR: unexpected CMSSW_VERSION=$CMSSW_VERSION" >&2
  exit 1
fi

if [[ "$SCRAM_ARCH" != "$ARCH" ]]; then
  echo "ERROR: unexpected SCRAM_ARCH=$SCRAM_ARCH" >&2
  exit 1
fi


echo "==> Initializing CMSSW Git development area"

git cms-init


if [[ -n "$PACKAGE" ]]; then
  echo "==> Adding package: $PACKAGE"

  git cms-addpkg "$PACKAGE"

  echo "==> Building with $JOBS jobs"

  scram b -j "$JOBS"
fi


echo
echo "CMSSW bootstrap completed successfully."
echo
echo "Release:"
echo "  $CMSSW_VERSION"
echo
echo "Architecture:"
echo "  $SCRAM_ARCH"
echo
echo "Development area:"
echo "  $CMSSW_BASE"
REMOTE