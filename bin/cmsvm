#!/usr/bin/env bash

set -euo pipefail

INSTANCE="${CMSSW_LIMA_INSTANCE:-cmssw}"
SSH_ALIAS="lima-${INSTANCE}"

SCRIPT_DIR="$(
  cd "$(dirname "${BASH_SOURCE[0]}")"
  pwd
)"

REPO_ROOT="$(
  cd "$SCRIPT_DIR/.."
  pwd
)"

TEMPLATE="$REPO_ROOT/lima/cmssw.yaml"
LIMA_SSH_CONFIG="$HOME/.lima/$INSTANCE/ssh.config"

# Host directories mounted into the VM. Machine-specific, so not tracked.
# One mount per line: HOST_DIR<TAB>GUEST_DIR<TAB>ro|rw
MOUNTS_FILE="$REPO_ROOT/config/mounts.local"


usage() {
  cat <<EOF
Usage:

  cmsvm host-setup
  cmsvm validate
  cmsvm create
  cmsvm start
  cmsvm shell
  cmsvm ssh
  cmsvm stop
  cmsvm status
  cmsvm doctor
  cmsvm terminfo
  cmsvm delete

  cmsvm mount HOST_DIR [GUEST_DIR] [--rw]
  cmsvm unmount GUEST_DIR
  cmsvm mounts

Mounts are read-only unless --rw is given. GUEST_DIR defaults to
/mnt/<name of HOST_DIR>. They are saved in config/mounts.local and
re-applied by 'cmsvm create'. Changing mounts restarts a running VM.

Instance:
  $INSTANCE

Template:
  $TEMPLATE
EOF
}

check_host_git_identity() {
  local missing=0

  for key in user.name user.email user.github; do
    if [[ -z "$(git config --global --get "$key" || true)" ]]; then
      echo "ERROR: missing host Git config: $key" >&2
      missing=1
    fi
  done

  if (( missing )); then
    echo >&2
    echo "Configure the missing values on macOS before creating the VM." >&2
    return 1
  fi
}


sync_git_identity() {
  local name email github

  name="$(git config --global --get user.name || true)"
  email="$(git config --global --get user.email || true)"
  github="$(git config --global --get user.github || true)"

  if [[ -z "$name" || -z "$email" || -z "$github" ]]; then
    echo "ERROR: host Git identity is incomplete." >&2
    echo >&2
    echo "Configure these once on macOS:" >&2
    echo "  git config --global user.name 'Your Name'" >&2
    echo "  git config --global user.email 'you@example.com'" >&2
    echo "  git config --global user.github 'github-username'" >&2
    exit 1
  fi

  echo "==> Syncing Git identity into guest"

  ssh "$SSH_ALIAS" \
    git config --global user.name "$name"

  ssh "$SSH_ALIAS" \
    git config --global user.email "$email"

  ssh "$SSH_ALIAS" \
    git config --global user.github "$github"
}


ensure_lima_ssh_include() {
  local ssh_dir="$HOME/.ssh"
  local ssh_config="$ssh_dir/config"
  local include_line='Include ~/.lima/*/ssh.config'
  local tmp

  mkdir -p "$ssh_dir"
  chmod 700 "$ssh_dir"

  touch "$ssh_config"
  chmod 600 "$ssh_config"

  tmp="$(mktemp)"

  # The Include must be outside any Host stanza.
  # Putting it first guarantees that.
  {
    printf '%s\n\n' "$include_line"
    grep -vFx "$include_line" "$ssh_config" || true
  } > "$tmp"

  cat "$tmp" > "$ssh_config"
  rm -f "$tmp"

  chmod 600 "$ssh_config"
}


close_lima_controlmaster() {
  if [[ ! -f "$LIMA_SSH_CONFIG" ]]; then
    return 0
  fi

  # Lima may have opened its persistent SSH connection before guest
  # provisioning changed the account login shell to zsh.
  #
  # Closing it forces the next session to re-read /etc/passwd.
  ssh \
    -F "$LIMA_SSH_CONFIG" \
    -O exit \
    "$SSH_ALIAS" \
    >/dev/null 2>&1 || true
}


install_host_terminfo() {
  if [[ ! -f "$LIMA_SSH_CONFIG" ]]; then
    echo "Lima SSH config not found: $LIMA_SSH_CONFIG" >&2
    return 1
  fi

  # Ghostty advertises xterm-ghostty. AlmaLinux 9's ncurses is old enough
  # that this terminfo is generally not installed system-wide.
  #
  # Install the host's exact definition into the guest user's private
  # terminfo database.
  if [[ "${TERM:-}" == "xterm-ghostty" ]]; then

    if ! command -v infocmp >/dev/null 2>&1; then
      echo "warning: host infocmp not found; skipping Ghostty terminfo setup" >&2
      return 0
    fi

    if ! infocmp -x xterm-ghostty >/dev/null 2>&1; then
      echo "warning: host xterm-ghostty terminfo unavailable; skipping" >&2
      return 0
    fi

    echo "==> Installing Ghostty terminfo in guest"

    infocmp -x xterm-ghostty |
      ssh \
        -F "$LIMA_SSH_CONFIG" \
        "$SSH_ALIAS" \
        'mkdir -p "$HOME/.terminfo" && tic -x -o "$HOME/.terminfo" -'

  fi
}


instance_exists() {
  [[ -e "$HOME/.lima/$INSTANCE" ]]
}


instance_status() {
  limactl list "$INSTANCE" --format '{{.Status}}'
}


# yq expression that adds one mount to a Lima config.
mount_set_expr() {
  local host="$1" guest="$2" mode="$3"
  local writable=false

  if [[ "$mode" == rw ]]; then
    writable=true
  fi

  printf '.mounts += [{"location": "%s", "mountPoint": "%s", "writable": %s}]' \
    "$host" "$guest" "$writable"
}


mount_saved() {
  [[ -f "$MOUNTS_FILE" ]] &&
    awk -F '\t' -v g="$1" '$2 == g { found = 1 } END { exit !found }' "$MOUNTS_FILE"
}


check_mount_path() {
  case "$1" in
    *'"'* | *'\'* | *$'\t'* | *$'\n'*)
      echo "ERROR: unsupported character in path: $1" >&2
      exit 1
      ;;
  esac
}


# Apply a yq expression to the instance config. Lima only edits stopped
# instances, so a running VM is stopped and started again.
edit_instance() {
  local expr="$1"
  local was_running=0

  if ! instance_exists; then
    echo "Instance '$INSTANCE' does not exist; 'cmsvm create' will apply this."
    return 0
  fi

  if [[ "$(instance_status)" == "Running" ]]; then
    was_running=1
    echo "==> Stopping $INSTANCE to change mounts (open VM shells will close)"
    limactl stop "$INSTANCE"
  fi

  limactl edit --tty=false --set "$expr" "$INSTANCE"

  if (( was_running )); then
    echo "==> Starting $INSTANCE"
    limactl start "$INSTANCE"
    close_lima_controlmaster
  fi
}


add_mount() {
  local host="" guest="" mode=ro

  while (( $# )); do
    case "$1" in
      --rw) mode=rw ;;
      -*)
        echo "ERROR: unknown option: $1" >&2
        exit 1
        ;;
      *)
        if [[ -z "$host" ]]; then
          host="$1"
        elif [[ -z "$guest" ]]; then
          guest="$1"
        else
          usage
          exit 1
        fi
        ;;
    esac
    shift
  done

  if [[ -z "$host" ]]; then
    usage
    exit 1
  fi

  if [[ ! -d "$host" ]]; then
    echo "ERROR: not a directory: $host" >&2
    exit 1
  fi

  host="$(cd "$host" && pwd)"
  guest="${guest:-/mnt/$(basename "$host")}"
  guest="${guest%/}"

  if [[ "$guest" != /?* ]]; then
    echo "ERROR: GUEST_DIR must be an absolute path other than /: $guest" >&2
    exit 1
  fi

  check_mount_path "$host"
  check_mount_path "$guest"

  if mount_saved "$guest"; then
    echo "ERROR: $guest is already mounted. Unmount it first:" >&2
    echo "  cmsvm unmount $guest" >&2
    exit 1
  fi

  edit_instance "$(mount_set_expr "$host" "$guest" "$mode")"

  printf '%s\t%s\t%s\n' "$host" "$guest" "$mode" >> "$MOUNTS_FILE"

  echo "Mounted $host at $guest ($mode)."
}


remove_mount() {
  local guest="${1:-}"
  local tmp

  if [[ -z "$guest" || $# -gt 1 ]]; then
    usage
    exit 1
  fi

  guest="${guest%/}"
  check_mount_path "$guest"

  if ! mount_saved "$guest"; then
    echo "ERROR: no saved mount at $guest (see: cmsvm mounts)" >&2
    exit 1
  fi

  edit_instance "del(.mounts[] | select(.mountPoint == \"$guest\"))"

  tmp="$(mktemp)"
  awk -F '\t' -v g="$guest" '$2 != g' "$MOUNTS_FILE" > "$tmp"
  cat "$tmp" > "$MOUNTS_FILE"
  rm -f "$tmp"

  echo "Unmounted $guest."
}


list_mounts() {
  echo "Saved in config/mounts.local (applied by 'cmsvm create'):"

  if [[ -s "$MOUNTS_FILE" ]]; then
    awk -F '\t' '{ printf "  %s -> %s (%s)\n", $1, $2, $3 }' "$MOUNTS_FILE"
  else
    echo "  none"
  fi

  if instance_exists; then
    echo
    echo "Active in instance '$INSTANCE':"
    limactl list "$INSTANCE" --format \
      '{{range .Config.Mounts}}  {{.Location}} -> {{.MountPoint}} (writable: {{.Writable}}){{"\n"}}{{else}}  none{{"\n"}}{{end}}'
  fi
}


run_doctor() {
  echo "==> Host"

  printf 'limactl: '
  limactl --version

  printf 'architecture: '
  uname -m

  printf 'terminal: '
  printf '%s\n' "${TERM:-unset}"

  echo
  echo "==> Lima template"

  limactl validate "$TEMPLATE"

  echo
  echo "==> Instance"

  limactl list "$INSTANCE"

  if [[ ! -f "$LIMA_SSH_CONFIG" ]]; then
    echo
    echo "ERROR: Lima SSH config does not exist:"
    echo "  $LIMA_SSH_CONFIG"
    exit 1
  fi

  echo
  echo "==> SSH resolution"

  ssh -G "$SSH_ALIAS" |
    awk '
      $1 == "hostname" ||
      $1 == "user" ||
      $1 == "port" ||
      $1 == "identityfile"
    '

  echo
  echo "==> Guest"

  ssh "$SSH_ALIAS" "HOST_TERM=$(printf '%q' "${TERM:-}") bash -s" <<'REMOTE'
set -e

printf "OS: "
cat /etc/almalinux-release

printf "architecture: "
uname -m

printf "login shell: "
getent passwd "$USER" | cut -d: -f7

printf "home: "
printf "%s\n" "$HOME"

printf "zsh: "
command -v zsh

printf "git: "
git --version

printf "nvim: "
nvim --version | head -1

printf "tmux: "
tmux -V

if [[ "${HOST_TERM:-}" == "xterm-ghostty" ]]; then
  printf "Ghostty terminfo: "
  if infocmp xterm-ghostty >/dev/null 2>&1; then
    echo "OK"
  else
    echo "MISSING"
    exit 1
  fi
fi

printf "CVMFS: "
rpm -q cvmfs

printf "autofs: "
systemctl is-active autofs

echo "CVMFS repositories:"
cvmfs_config probe

test -r /cvmfs/cms.cern.ch/cmsset_default.sh

echo "CMS environment:"
zsh -lc '
  source /cvmfs/cms.cern.ch/cmsset_default.sh
  printf "SCRAM_ARCH: %s\n" "$SCRAM_ARCH"
  printf "scramv1: "
  command -v scramv1
'
REMOTE

  echo
  echo "CMSSW VM checks passed."
}


case "${1:-}" in

  host-setup)
    echo "==> Configuring host SSH"
    check_host_git_identity
    ensure_lima_ssh_include
    ;;

  validate)
    limactl validate "$TEMPLATE"
    ;;

  create)
    echo "==> Running host preflight checks"
    check_host_git_identity

    echo "==> Configuring host SSH"
    ensure_lima_ssh_include

    echo "==> Validating Lima template"
    limactl validate "$TEMPLATE"

    if [[ -e "$HOME/.lima/$INSTANCE" ]]; then
      echo "ERROR: Lima instance '$INSTANCE' already exists." >&2
      echo "Delete it first with: cmsvm delete" >&2
      exit 1
    fi

    mount_args=()

    if [[ -f "$MOUNTS_FILE" ]]; then
      while IFS=$'\t' read -r host guest mode; do
        if [[ ! -d "$host" ]]; then
          echo "ERROR: mounted host directory is missing: $host" >&2
          echo "Recreate it or run: cmsvm unmount $guest" >&2
          exit 1
        fi

        echo "==> Mounting $host at $guest ($mode)"
        mount_args+=(--set "$(mount_set_expr "$host" "$guest" "$mode")")
      done < "$MOUNTS_FILE"
    fi

    echo "==> Creating Lima instance: $INSTANCE"

    # The ${...+...} form keeps bash 3.2 happy with an empty array.
    limactl create \
      --tty=false \
      --name="$INSTANCE" \
      ${mount_args[@]+"${mount_args[@]}"} \
      "$TEMPLATE"

    echo "==> Starting and provisioning: $INSTANCE"

    limactl start \
      --progress \
      "$INSTANCE"

    echo "==> Recycling initial Lima SSH connection"

    close_lima_controlmaster

    # Give sshd a moment after the multiplexed connection is closed.
    sleep 1

    sync_git_identity
    install_host_terminfo

    echo
    echo "==> Running post-install checks"

    run_doctor

    echo
    echo "CMSSW development VM is ready."
    echo "Enter it with:"
    echo
    echo "  cmsvm shell"
    echo
    ;;

  start)
    limactl start "$INSTANCE"
    ;;

  shell)
    ensure_lima_ssh_include

    status="$(
      limactl list "$INSTANCE" \
        --format '{{.Status}}'
    )"

    if [[ "$status" != "Running" ]]; then
      limactl start "$INSTANCE" >/dev/null
    fi

    exec ssh "$SSH_ALIAS"
    ;;

  ssh)
    ensure_lima_ssh_include
    exec ssh "$SSH_ALIAS"
    ;;

  terminfo)
    install_host_terminfo
    ;;

  doctor)
    ensure_lima_ssh_include
    run_doctor
    ;;

  stop)
    limactl stop "$INSTANCE"
    ;;

  status)
    limactl list "$INSTANCE"
    ;;

  delete)
    limactl stop "$INSTANCE" 2>/dev/null || true
    limactl delete "$INSTANCE"
    ;;

  mount)
    shift
    add_mount "$@"
    ;;

  unmount)
    shift
    remove_mount "$@"
    ;;

  mounts)
    list_mounts
    ;;

  *)
    usage
    exit 1
    ;;

esac