#!/usr/bin/env bash

set -euo pipefail

INSTANCE="${CMSSW_LIMA_INSTANCE:-cmssw}"
SSH_ALIAS="lima-${INSTANCE}"

SCRIPT_DIR="$(
  cd "$(dirname "${BASH_SOURCE[0]}")"
  pwd
)"

REPO_ROOT="$(
  cd "$SCRIPT_DIR/.."
  pwd
)"

TEMPLATE="$REPO_ROOT/lima/cmssw.yaml"
LIMA_SSH_CONFIG="$HOME/.lima/$INSTANCE/ssh.config"

# launchd job that runs the VM. See start_instance.
LAUNCHD_LABEL="cmsvm.$INSTANCE"
LAUNCHD_DOMAIN="gui/$(id -u)"

# Host directories mounted into the VM. Machine-specific, so not tracked.
# One mount per line: HOST_DIR<TAB>GUEST_DIR<TAB>ro|rw
MOUNTS_FILE="$REPO_ROOT/config/mounts.local"


usage() {
  cat <<EOF
Usage:

  cmsvm host-setup
  cmsvm validate
  cmsvm create
  cmsvm sync
  cmsvm start
  cmsvm shell
  cmsvm ssh
  cmsvm stop
  cmsvm status
  cmsvm doctor
  cmsvm terminfo
  cmsvm delete

  cmsvm mount HOST_DIR [GUEST_DIR] [--rw]
  cmsvm unmount GUEST_DIR
  cmsvm mounts

'cmsvm sync' installs the repository's guest/ files (tools, .zshrc,
Neovim config, cmssw-el8) into the VM; 'cmsvm create' runs it too. It
also copies the host's Git identity again and brings the VM's
provisioning scripts up to date with the template, which restarts a
running VM when they changed.

Personal dotfiles: when \$CMSVM_DOTFILES (default ~/dotfiles) has an
install.sh, 'cmsvm sync' copies it to ~/dotfiles in the VM and runs it,
and the dotfiles' .zshrc and Neovim config replace guest/'s. The CMS
shell setup is installed either way. CMSVM_DOTFILES=none turns this off.

Mounts are read-only unless --rw is given. GUEST_DIR defaults to
/mnt/<name of HOST_DIR>. They are saved in config/mounts.local and
re-applied by 'cmsvm create'. Changing mounts restarts a running VM.

Instance:
  $INSTANCE

Template:
  $TEMPLATE
EOF
}

check_host_git_identity() {
  local missing=0

  for key in user.name user.email user.github; do
    if [[ -z "$(git config --global --get "$key" || true)" ]]; then
      echo "ERROR: missing host Git config: $key" >&2
      missing=1
    fi
  done

  if (( missing )); then
    echo >&2
    echo "Configure the missing values on macOS before creating the VM." >&2
    return 1
  fi
}


sync_git_identity() {
  local name email github

  name="$(git config --global --get user.name || true)"
  email="$(git config --global --get user.email || true)"
  github="$(git config --global --get user.github || true)"

  if [[ -z "$name" || -z "$email" || -z "$github" ]]; then
    echo "ERROR: host Git identity is incomplete." >&2
    echo >&2
    echo "Configure these once on macOS:" >&2
    echo "  git config --global user.name 'Your Name'" >&2
    echo "  git config --global user.email 'you@example.com'" >&2
    echo "  git config --global user.github 'github-username'" >&2
    exit 1
  fi

  echo "==> Syncing Git identity into guest"

  # ssh joins its arguments into one command line for the remote shell,
  # so quote the values for it ("Jane Doe" would otherwise lose "Doe").
  # --replace-all also cleans up the duplicate entries that the unquoted
  # version left behind.
  ssh "$SSH_ALIAS" \
    "git config --global --replace-all user.name $(printf '%q' "$name")"

  ssh "$SSH_ALIAS" \
    "git config --global --replace-all user.email $(printf '%q' "$email")"

  ssh "$SSH_ALIAS" \
    "git config --global --replace-all user.github $(printf '%q' "$github")"
}


ensure_lima_ssh_include() {
  local ssh_dir="$HOME/.ssh"
  local ssh_config="$ssh_dir/config"
  local include_line='Include ~/.lima/*/ssh.config'
  local tmp

  mkdir -p "$ssh_dir"
  chmod 700 "$ssh_dir"

  # Create it if missing; touching an existing file would change its
  # modification time on every run.
  if [[ ! -e "$ssh_config" ]]; then
    touch "$ssh_config"
  fi
  chmod 600 "$ssh_config"

  tmp="$(mktemp)"

  # The Include must be outside any Host stanza.
  # Putting it first guarantees that. The blank lines that followed it are
  # dropped too, so repeated runs don't pile them up.
  {
    printf '%s\n\n' "$include_line"
    { grep -vFx "$include_line" "$ssh_config" || true; } | sed '/./,$!d'
  } > "$tmp"

  # Only write when something changed.
  if ! cmp -s "$tmp" "$ssh_config"; then
    cat "$tmp" > "$ssh_config"
  fi
  rm -f "$tmp"

  chmod 600 "$ssh_config"
}


close_lima_controlmaster() {
  if [[ ! -f "$LIMA_SSH_CONFIG" ]]; then
    return 0
  fi

  # Lima may have opened its persistent SSH connection before guest
  # provisioning changed the account login shell to zsh.
  #
  # Closing it forces the next session to re-read /etc/passwd.
  ssh \
    -F "$LIMA_SSH_CONFIG" \
    -O exit \
    "$SSH_ALIAS" \
    >/dev/null 2>&1 || true
}


install_host_terminfo() {
  if [[ ! -f "$LIMA_SSH_CONFIG" ]]; then
    echo "Lima SSH config not found: $LIMA_SSH_CONFIG" >&2
    return 1
  fi

  # Ghostty advertises xterm-ghostty. AlmaLinux 9's ncurses is old enough
  # that this terminfo is generally not installed system-wide.
  #
  # Install the host's exact definition into the guest user's private
  # terminfo database.
  if [[ "${TERM:-}" == "xterm-ghostty" ]]; then

    if ! command -v infocmp >/dev/null 2>&1; then
      echo "warning: host infocmp not found; skipping Ghostty terminfo setup" >&2
      return 0
    fi

    if ! infocmp -x xterm-ghostty >/dev/null 2>&1; then
      echo "warning: host xterm-ghostty terminfo unavailable; skipping" >&2
      return 0
    fi

    echo "==> Installing Ghostty terminfo in guest"

    infocmp -x xterm-ghostty |
      ssh \
        -F "$LIMA_SSH_CONFIG" \
        "$SSH_ALIAS" \
        'mkdir -p "$HOME/.terminfo" && tic -x -o "$HOME/.terminfo" -'

  fi
}


# Personal dotfiles to install in the VM after guest/: $CMSVM_DOTFILES, or
# ~/dotfiles when it exists. They need an executable install.sh at the top.
# CMSVM_DOTFILES=none turns this off.
dotfiles_dir() {
  local dir="${CMSVM_DOTFILES:-$HOME/dotfiles}"

  [[ "$dir" != none && -x "$dir/install.sh" ]] || return 1
  printf '%s\n' "$dir"
}


# Copy guest/ into the VM and install it. See guest/install.sh.
sync_guest() {
  local dest=".local/share/cmssw-workspace/guest"
  local with_dotfiles=0

  if dotfiles_dir >/dev/null; then
    with_dotfiles=1
  fi

  echo "==> Installing guest tools and configuration"

  ssh "$SSH_ALIAS" mkdir -p "$dest"
  rsync -a --delete "$REPO_ROOT/guest/" "$SSH_ALIAS:$dest/"
  ssh "$SSH_ALIAS" "CMSVM_DOTFILES=$with_dotfiles bash $dest/install.sh"
}


# Copy the personal dotfiles to ~/dotfiles in the VM and run their
# install.sh, which links their .zshrc, Neovim config and so on.
sync_dotfiles() {
  local dir

  if ! dir="$(dotfiles_dir)"; then
    return 0
  fi

  echo "==> Installing dotfiles from $dir"

  rsync -a --delete --exclude .git "$dir/" "$SSH_ALIAS:dotfiles/"
  # Non-interactive SSH: the guest tools in ~/.local/bin are not on PATH.
  ssh "$SSH_ALIAS" 'PATH="$HOME/.local/bin:$PATH" "$HOME/dotfiles/install.sh"'
}


# Lima runs the provisioning scripts at every boot, from the copy of the
# template made when the VM was created. Bring that copy up to date, so a
# VM created from an older template stops running old scripts (an early
# one rewrote ~/.zshrc at every boot). Restarts a running VM if needed.
sync_provision() {
  local current wanted

  if ! instance_exists; then
    return 0
  fi

  current="$(limactl template yq "$HOME/.lima/$INSTANCE/lima.yaml" '.provision')"
  wanted="$(limactl template yq "$TEMPLATE" '.provision')"

  if [[ "$current" == "$wanted" ]]; then
    return 0
  fi

  # Lima blocks file reads in --set expressions, so pass the scripts inline.
  edit_instance \
    ".provision = $(limactl template yq "$TEMPLATE" '.provision | tojson(0)')" \
    "update its provisioning scripts"
}


instance_exists() {
  [[ -e "$HOME/.lima/$INSTANCE" ]]
}


instance_status() {
  limactl list "$INSTANCE" --format '{{.Status}}'
}


# Start the VM from a launchd job instead of from this shell. macOS
# groups a process with the app it was started from, and quitting the app
# kills the group: a VM started in a Ghostty shell went down, without a
# clean shutdown, when Ghostty was quit. Lima's own login autostart uses
# the same kind of job but also boots the VM at every login.
#
# --progress shows the cloud-init log while waiting.
start_instance() {
  local dir="$HOME/.lima/$INSTANCE"
  local plist="$dir/cmsvm-launchd.plist"
  local events="$dir/ha.stdout.log"
  local target="$LAUNCHD_DOMAIN/$LAUNCHD_LABEL"
  local progress=0 shown=0 lines deadline
  local args=(start --tty=false)

  if [[ "${1:-}" == --progress ]]; then
    progress=1
    args+=(--progress)
  fi

  if ! instance_exists; then
    echo "ERROR: instance '$INSTANCE' does not exist. Create it with: cmsvm create" >&2
    return 1
  fi

  if [[ "$(instance_status)" == Running ]]; then
    echo "$INSTANCE is already running."
    return 0
  fi

  # --foreground makes limactl exec the host agent, which keeps the VM
  # running, in the job's own process.
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LAUNCHD_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(command -v limactl)</string>
$(printf '    <string>%s</string>\n' "${args[@]}" "$INSTANCE" --foreground)
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>WorkingDirectory</key>
  <string>$dir</string>
  <key>StandardOutPath</key>
  <string>$dir/cmsvm-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>$dir/cmsvm-launchd.log</string>
</dict>
</plist>
EOF

  # The job from the previous start stays loaded after the VM stops.
  launchctl bootout "$target" 2>/dev/null || true
  # Lima recreates the event log; don't let the last run's events count.
  rm -f "$events"
  launchctl bootstrap "$LAUNCHD_DOMAIN" "$plist"

  echo "==> Waiting for $INSTANCE to boot"

  deadline=$((SECONDS + 600))

  while :; do
    if (( progress )) && [[ -f "$events" ]]; then
      lines=$(($(wc -l < "$events")))
      if (( lines > shown )); then
        sed -n "$((shown + 1)),${lines}p" "$events" |
          jq -r '.status.cloudInitProgress.logLine // empty | "[cloud-init] " + .' ||
          true
        shown="$lines"
      fi
    fi

    # With --progress, also wait for cloud-init to finish, as
    # 'limactl start --progress' does.
    if grep -qF '"running":true' "$events" 2>/dev/null &&
      { (( ! progress )) || grep -qF '"completed":true' "$events"; }; then
      return 0
    fi

    if grep -qF '"exiting":true' "$events" 2>/dev/null ||
      ! launchctl print "$target" 2>/dev/null |
        grep -qF 'last exit code = (never exited)'; then
      echo "ERROR: $INSTANCE failed to start. See:" >&2
      echo "  $dir/cmsvm-launchd.log" >&2
      echo "  $dir/ha.stderr.log" >&2
      return 1
    fi

    if (( SECONDS > deadline )); then
      echo "ERROR: $INSTANCE did not finish booting in 10 minutes." >&2
      echo "See: $dir/ha.stderr.log" >&2
      return 1
    fi

    sleep 1
  done
}


# yq expression that adds one mount to a Lima config.
mount_set_expr() {
  local host="$1" guest="$2" mode="$3"
  local writable=false

  if [[ "$mode" == rw ]]; then
    writable=true
  fi

  printf '.mounts += [{"location": "%s", "mountPoint": "%s", "writable": %s}]' \
    "$host" "$guest" "$writable"
}


mount_saved() {
  [[ -f "$MOUNTS_FILE" ]] &&
    awk -F '\t' -v g="$1" '$2 == g { found = 1 } END { exit !found }' "$MOUNTS_FILE"
}


check_mount_path() {
  case "$1" in
    *'"'* | *'\'* | *$'\t'* | *$'\n'*)
      echo "ERROR: unsupported character in path: $1" >&2
      exit 1
      ;;
  esac
}


# Apply a yq expression to the instance config. Lima only edits stopped
# instances, so a running VM is stopped and started again.
edit_instance() {
  local expr="$1"
  local why="${2:-change mounts}"
  local was_running=0

  if ! instance_exists; then
    echo "Instance '$INSTANCE' does not exist; 'cmsvm create' will apply this."
    return 0
  fi

  if [[ "$(instance_status)" == "Running" ]]; then
    was_running=1
    echo "==> Stopping $INSTANCE to $why (open VM shells will close)"
    limactl stop "$INSTANCE"
  fi

  limactl edit --tty=false --set "$expr" "$INSTANCE"

  if (( was_running )); then
    echo "==> Starting $INSTANCE"
    start_instance
    close_lima_controlmaster
  fi
}


add_mount() {
  local host="" guest="" mode=ro

  while (( $# )); do
    case "$1" in
      --rw) mode=rw ;;
      -*)
        echo "ERROR: unknown option: $1" >&2
        exit 1
        ;;
      *)
        if [[ -z "$host" ]]; then
          host="$1"
        elif [[ -z "$guest" ]]; then
          guest="$1"
        else
          usage
          exit 1
        fi
        ;;
    esac
    shift
  done

  if [[ -z "$host" ]]; then
    usage
    exit 1
  fi

  if [[ ! -d "$host" ]]; then
    echo "ERROR: not a directory: $host" >&2
    exit 1
  fi

  host="$(cd "$host" && pwd)"
  guest="${guest:-/mnt/$(basename "$host")}"
  guest="${guest%/}"

  if [[ "$guest" != /?* ]]; then
    echo "ERROR: GUEST_DIR must be an absolute path other than /: $guest" >&2
    exit 1
  fi

  check_mount_path "$host"
  check_mount_path "$guest"

  if mount_saved "$guest"; then
    echo "ERROR: $guest is already mounted. Unmount it first:" >&2
    echo "  cmsvm unmount $guest" >&2
    exit 1
  fi

  edit_instance "$(mount_set_expr "$host" "$guest" "$mode")"

  printf '%s\t%s\t%s\n' "$host" "$guest" "$mode" >> "$MOUNTS_FILE"

  echo "Mounted $host at $guest ($mode)."
}


remove_mount() {
  local guest="${1:-}"
  local tmp

  if [[ -z "$guest" || $# -gt 1 ]]; then
    usage
    exit 1
  fi

  guest="${guest%/}"
  check_mount_path "$guest"

  if ! mount_saved "$guest"; then
    echo "ERROR: no saved mount at $guest (see: cmsvm mounts)" >&2
    exit 1
  fi

  edit_instance "del(.mounts[] | select(.mountPoint == \"$guest\"))"

  tmp="$(mktemp)"
  awk -F '\t' -v g="$guest" '$2 != g' "$MOUNTS_FILE" > "$tmp"
  cat "$tmp" > "$MOUNTS_FILE"
  rm -f "$tmp"

  echo "Unmounted $guest."
}


list_mounts() {
  echo "Saved in config/mounts.local (applied by 'cmsvm create'):"

  if [[ -s "$MOUNTS_FILE" ]]; then
    awk -F '\t' '{ printf "  %s -> %s (%s)\n", $1, $2, $3 }' "$MOUNTS_FILE"
  else
    echo "  none"
  fi

  if instance_exists; then
    echo
    echo "Active in instance '$INSTANCE':"
    limactl list "$INSTANCE" --format \
      '{{range .Config.Mounts}}  {{.Location}} -> {{.MountPoint}} (writable: {{.Writable}}){{"\n"}}{{else}}  none{{"\n"}}{{end}}'
  fi
}


run_doctor() {
  echo "==> Host"

  printf 'limactl: '
  limactl --version

  printf 'architecture: '
  uname -m

  printf 'terminal: '
  printf '%s\n' "${TERM:-unset}"

  echo
  echo "==> Lima template"

  limactl validate "$TEMPLATE"

  echo
  echo "==> Instance"

  limactl list "$INSTANCE"

  if [[ ! -f "$LIMA_SSH_CONFIG" ]]; then
    echo
    echo "ERROR: Lima SSH config does not exist:"
    echo "  $LIMA_SSH_CONFIG"
    exit 1
  fi

  echo
  echo "==> SSH resolution"

  ssh -G "$SSH_ALIAS" |
    awk '
      $1 == "hostname" ||
      $1 == "user" ||
      $1 == "port" ||
      $1 == "identityfile"
    '

  echo
  echo "==> Guest"

  ssh "$SSH_ALIAS" "HOST_TERM=$(printf '%q' "${TERM:-}") bash -s" <<'REMOTE'
set -e

printf "OS: "
cat /etc/almalinux-release

printf "architecture: "
uname -m

printf "login shell: "
getent passwd "$USER" | cut -d: -f7

printf "home: "
printf "%s\n" "$HOME"

printf "zsh: "
command -v zsh

printf "git: "
git --version

# Installed by `cmsvm sync`, not on this non-interactive shell's PATH.
for tool in nvim rg fzf clangd; do
  printf "%s: " "$tool"
  "$HOME/.local/bin/$tool" --version | head -1
done

printf "tmux: "
tmux -V

if [[ "${HOST_TERM:-}" == "xterm-ghostty" ]]; then
  printf "Ghostty terminfo: "
  if infocmp xterm-ghostty >/dev/null 2>&1; then
    echo "OK"
  else
    echo "MISSING"
    exit 1
  fi
fi

printf "CVMFS: "
rpm -q cvmfs

printf "autofs: "
systemctl is-active autofs

echo "CVMFS repositories:"
cvmfs_config probe

test -r /cvmfs/cms.cern.ch/cmsset_default.sh

echo "CMS environment:"
zsh -lc '
  source /cvmfs/cms.cern.ch/cmsset_default.sh
  printf "SCRAM_ARCH: %s\n" "$SCRAM_ARCH"
  printf "scramv1: "
  command -v scramv1
'

printf "el8 container: "
"$HOME/bin/cmssw-el8" cat /etc/redhat-release

printf "nvim in el8 container: "
"$HOME/bin/cmssw-el8" "$HOME/.local/bin/nvim" --version | head -1
REMOTE

  echo
  echo "CMSSW VM checks passed."
}


case "${1:-}" in

  host-setup)
    echo "==> Configuring host SSH"
    check_host_git_identity
    ensure_lima_ssh_include
    ;;

  validate)
    limactl validate "$TEMPLATE"
    ;;

  create)
    echo "==> Running host preflight checks"
    check_host_git_identity

    echo "==> Configuring host SSH"
    ensure_lima_ssh_include

    echo "==> Validating Lima template"
    limactl validate "$TEMPLATE"

    if [[ -e "$HOME/.lima/$INSTANCE" ]]; then
      echo "ERROR: Lima instance '$INSTANCE' already exists." >&2
      echo "Delete it first with: cmsvm delete" >&2
      exit 1
    fi

    mount_args=()

    if [[ -f "$MOUNTS_FILE" ]]; then
      while IFS=$'\t' read -r host guest mode; do
        if [[ ! -d "$host" ]]; then
          echo "ERROR: mounted host directory is missing: $host" >&2
          echo "Recreate it or run: cmsvm unmount $guest" >&2
          exit 1
        fi

        echo "==> Mounting $host at $guest ($mode)"
        mount_args+=(--set "$(mount_set_expr "$host" "$guest" "$mode")")
      done < "$MOUNTS_FILE"
    fi

    echo "==> Creating Lima instance: $INSTANCE"

    # The ${...+...} form keeps bash 3.2 happy with an empty array.
    limactl create \
      --tty=false \
      --name="$INSTANCE" \
      ${mount_args[@]+"${mount_args[@]}"} \
      "$TEMPLATE"

    echo "==> Starting and provisioning: $INSTANCE"

    start_instance --progress

    echo "==> Recycling initial Lima SSH connection"

    close_lima_controlmaster

    # Give sshd a moment after the multiplexed connection is closed.
    sleep 1

    sync_git_identity
    install_host_terminfo
    sync_guest
    sync_dotfiles

    echo
    echo "==> Running post-install checks"

    run_doctor

    echo
    echo "CMSSW development VM is ready."
    echo "Enter it with:"
    echo
    echo "  cmsvm shell"
    echo
    ;;

  start)
    start_instance
    ;;

  shell)
    ensure_lima_ssh_include

    status="$(
      limactl list "$INSTANCE" \
        --format '{{.Status}}'
    )"

    if [[ "$status" != "Running" ]]; then
      start_instance >/dev/null
    fi

    exec ssh "$SSH_ALIAS"
    ;;

  ssh)
    ensure_lima_ssh_include
    exec ssh "$SSH_ALIAS"
    ;;

  terminfo)
    install_host_terminfo
    ;;

  sync)
    sync_provision
    sync_git_identity
    sync_guest
    sync_dotfiles
    ;;

  doctor)
    ensure_lima_ssh_include
    run_doctor
    ;;

  stop)
    limactl stop "$INSTANCE"
    launchctl bootout "$LAUNCHD_DOMAIN/$LAUNCHD_LABEL" 2>/dev/null || true
    ;;

  status)
    limactl list "$INSTANCE"
    ;;

  delete)
    limactl stop "$INSTANCE" 2>/dev/null || true
    launchctl bootout "$LAUNCHD_DOMAIN/$LAUNCHD_LABEL" 2>/dev/null || true
    limactl delete "$INSTANCE"
    ;;

  mount)
    shift
    add_mount "$@"
    ;;

  unmount)
    shift
    remove_mount "$@"
    ;;

  mounts)
    list_mounts
    ;;

  *)
    usage
    exit 1
    ;;

esac